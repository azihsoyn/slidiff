# vhs tape for the README demo: read, mark seen, dive, flag, come back.
# Regenerate with: vhs demo.tape
Output demo.gif

Set FontSize 15
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Shell "bash"

Hide
Type "slidiff examples/demo.md"
Enter
Sleep 2s
Show

Sleep 2.5s
Type "n"
Sleep 2s
Type "n"
Sleep 1.5s
Type "n"
Sleep 2.5s
Type "v"
Sleep 1.5s
Type "n"
Sleep 2s
Type "n"
Sleep 1.5s
Type "n"
Sleep 2.5s
Type "v"
Sleep 1.2s
Enter
Sleep 2s
Type "n"
Sleep 400ms
Type "n"
Sleep 400ms
Type "v"
Sleep 800ms
Type "v"
Sleep 800ms
Type "v"
Sleep 800ms
Type "x"
Sleep 1.5s
Escape
Sleep 1.5s
Type "n"
Sleep 1.8s
Type "n"
Sleep 2s
Type "?"
Sleep 3s
Escape
Sleep 1s
Type "q"
Sleep 500ms

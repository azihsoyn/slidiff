{
  "$defs": {
    "Anchor": {
      "description": "An excerpt in the repository: \"src/main.rs:42\" (one line plus context) or \"src/main.rs:42-57\" (explicit range, at most 16 lines). Lines are on the new side of the diff.",
      "pattern": "^.+:[1-9][0-9]*(-[1-9][0-9]*)?$",
      "type": "string"
    },
    "Group": {
      "additionalProperties": false,
      "description": "A named group of files for the map step.",
      "properties": {
        "files": {
          "description": "Repo-relative paths, as they appear in the diff.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "label": {
          "maxLength": 24,
          "type": "string"
        }
      },
      "required": [
        "label",
        "files"
      ],
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "description": "One line of explanation attached to one line of code.",
      "properties": {
        "line": {
          "description": "Line number (new side) the note hangs off. Must fall inside the\nstep's range.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "maxLength": 48,
          "type": "string"
        }
      },
      "required": [
        "line",
        "text"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "Step": {
      "oneOf": [
        {
          "description": "Title slide: what happened, in at most three bullets.",
          "properties": {
            "bullets": {
              "description": "Up to three supporting lines.",
              "items": {
                "maxLength": 60,
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            },
            "speaker_notes": {
              "description": "Longer prose for the reader who wants the detail. Shown below\nthe slide, never on it.",
              "maxLength": 600,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "cover",
              "type": "string"
            },
            "what": {
              "description": "One line stating what was done.",
              "maxLength": 80,
              "type": "string"
            }
          },
          "required": [
            "type",
            "what"
          ],
          "type": "object"
        },
        {
          "description": "One claim about one excerpt. The viewer shows the chosen lines —\ndiff-aware when they changed, plain code when they did not — with\nnotes hanging off individual lines.",
          "properties": {
            "at": {
              "$ref": "#/$defs/Anchor"
            },
            "claim": {
              "maxLength": 80,
              "type": "string"
            },
            "notes": {
              "items": {
                "$ref": "#/$defs/Note"
              },
              "maxItems": 3,
              "type": "array"
            },
            "speaker_notes": {
              "maxLength": 600,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "point",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at",
            "claim"
          ],
          "type": "object"
        },
        {
          "description": "Old and new side by side for the excerpt at `at`.",
          "properties": {
            "at": {
              "$ref": "#/$defs/Anchor"
            },
            "claim": {
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "speaker_notes": {
              "maxLength": 600,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "before_after",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at"
          ],
          "type": "object"
        },
        {
          "description": "A point that could go wrong, with a severity.",
          "properties": {
            "at": {
              "$ref": "#/$defs/Anchor"
            },
            "claim": {
              "maxLength": 80,
              "type": "string"
            },
            "notes": {
              "items": {
                "$ref": "#/$defs/Note"
              },
              "maxItems": 3,
              "type": "array"
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "speaker_notes": {
              "maxLength": 600,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "risk",
              "type": "string"
            }
          },
          "required": [
            "type",
            "at",
            "claim",
            "severity"
          ],
          "type": "object"
        },
        {
          "description": "The touched files, summarized by the writer into named groups.\nFiles not covered by any group aggregate into an automatic rest row.\nCounts are drawn from the repo at display time.",
          "properties": {
            "groups": {
              "items": {
                "$ref": "#/$defs/Group"
              },
              "maxItems": 6,
              "minItems": 1,
              "type": "array"
            },
            "speaker_notes": {
              "maxLength": 600,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "map",
              "type": "string"
            }
          },
          "required": [
            "type",
            "groups"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "description": "Git rev to diff against (e.g. \"main\", \"HEAD~3\"). Defaults to HEAD:\nuncommitted changes against the last commit.",
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "description": "The slides. At most 12 — the schema refuses more.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "description": "One line naming what this deck reports on.",
      "maxLength": 80,
      "type": "string"
    }
  },
  "required": [
    "title",
    "steps"
  ],
  "title": "Deck",
  "type": "object"
}
